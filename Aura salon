<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aura Salon | Luxury Beauty Riyadh</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/framer-motion/10.16.4/framer-motion.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Inter:wght@200;300;400&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #FDFBF7; color: #1A1A1A; }
        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; }
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,0,0,0.05); }
        .gold-text { color: #C5A059; }
        .bg-gold { background-color: #C5A059; }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav class="fixed w-full z-50 glass px-8 py-6 flex justify-between items-center">
        <div class="text-2xl font-bold tracking-tighter">AURA SALON</div>
        <div class="hidden md:flex gap-8 uppercase text-xs tracking-widest font-medium">
            <a href="#services" class="hover:text-[#C5A059] transition-all">Services</a>
            <a href="#gallery" class="hover:text-[#C5A059] transition-all">Gallery</a>
            <a href="#contact" class="hover:text-[#C5A059] transition-all">Contact</a>
        </div>
        <a href="#booking" class="bg-black text-white px-6 py-2 text-xs uppercase tracking-widest hover:bg-[#C5A059] transition-all">Book Now</a>
    </nav>

    <!-- Hero Section -->
    <header class="h-screen flex items-center justify-center text-center px-4 relative">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&q=80')] bg-cover bg-center"></div>
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative z-10 text-white">
            <h1 class="text-7xl md:text-9xl mb-6">Redefining Radiance</h1>
            <p class="text-xl font-light mb-8 max-w-lg mx-auto">Experience bespoke beauty treatments in the heart of Riyadh.</p>
            <div class="flex gap-4 justify-center">
                <button class="border border-white px-8 py-4 hover:bg-white hover:text-black transition-all">Explore Services</button>
            </div>
        </div>
    </header>

    <!-- Services Section -->
    <section id="services" class="py-24 px-8 max-w-6xl mx-auto">
        <h2 class="text-5xl text-center mb-16">Signature Services</h2>
        <div class="grid md:grid-cols-3 gap-8">
            <!-- Service Card -->
            <div class="p-8 border border-gray-200 hover:border-[#C5A059] transition-all group">
                <h3 class="text-2xl mb-4">Hair Styling</h3>
                <p class="text-gray-600 mb-6">Expert cuts and styling tailored to your unique facial features.</p>
                <p class="gold-text font-semibold">From 350 SAR</p>
            </div>
            <div class="p-8 border border-gray-200 hover:border-[#C5A059] transition-all">
                <h3 class="text-2xl mb-4">Bridal Packages</h3>
                <p class="text-gray-600 mb-6">Full-day luxury preparation for your most important day.</p>
                <p class="gold-text font-semibold">Custom Pricing</p>
            </div>
            <div class="p-8 border border-gray-200 hover:border-[#C5A059] transition-all">
                <h3 class="text-2xl mb-4">VIP Skincare</h3>
                <p class="text-gray-600 mb-6">Rejuvenating facial treatments using premium ingredients.</p>
                <p class="gold-text font-semibold">From 500 SAR</p>
            </div>
        </div>
    </section>

    <!-- Booking CTA -->
    <section id="booking" class="py-24 bg-[#1A1A1A] text-white text-center px-8">
        <h2 class="text-5xl mb-8">Ready to transform?</h2>
        <p class="mb-8 text-gray-400">Secure your session with our elite stylists today.</p>
        <button class="bg-[#C5A059] text-black px-12 py-4 font-bold uppercase tracking-widest hover:scale-105 transition-transform">Book Your Appointment</button>
    </section>

    <!-- Footer -->
    <footer class="py-12 text-center text-sm border-t border-gray-200">
        <p>© 2026 Aura Salon. Located in Riyadh, Saudi Arabia.</p>
    </footer>

    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/yournumber" class="fixed bottom-8 right-8 bg-green-500 text-white p-4 rounded-full shadow-lg hover:bg-green-600 transition-colors">
        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.955c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>

    <script>
        // Simple animation trigger using Intersection Observer
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('animate-fade-in');
            });
        });
        document.querySelectorAll('section').forEach(s => observer.observe(s));
    </script>
</body>
</html>
